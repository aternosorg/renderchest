#!/usr/bin/env php
<?php
require_once 'vendor/autoload.php';

use Aternos\Renderchest\Output\ItemLibraryGenerator;

$shortOpts = "a:n:s:q:io:p:f:h";
$longOpts = [
    "assets:",
    "namespace:",
    "size:",
    "quality:",
    "item-list",
    "output:",
    "prefix:",
    "format:",
    "fallback",
    "help",
];

$options = getopt($shortOpts, $longOpts);

if (isset($options["h"]) || isset($options["help"])) {
    echo <<<HELP
    Generate icons and CSS for Minecraft items.

    Usage: renderchest -a <assets> -o <output> [options]

    Required:
      -a, --assets <path>      Assets folder (can be specified multiple times)
      -o, --output <path>      Output directory

    Options:
      -n, --namespace <name>   Asset namespace to render from (default: minecraft, can be specified multiple times)
      -s, --size <int>         Size of generated item icons (default: 64)
      -q, --quality <int>      Render quality multiplier (default: 2)
      -i, --item-list          Create a JSON file listing all rendered items
      -p, --prefix <string>    CSS class prefix (default: rc-)
      -f, --format <string>    Output image format (default: webp)
          --fallback           Create fallback textures as PNGs
      -h, --help               Show this help message

    HELP;
    exit(0);
}

function resolveOption(array $options, string $long, string $short, mixed $default = null): mixed
{
    return $options[$long] ?? $options[$short] ?? $default;
}

function resolveArrayOption(array $options, string $long, string $short, array $default = []): array
{
    $longVal = (array) ($options[$long] ?? []);
    $shortVal = (array) ($options[$short] ?? []);
    $merged = array_merge($longVal, $shortVal);
    return empty($merged) ? $default : $merged;
}

function resolvePath(string $path): string
{
    if (!str_starts_with($path, "/")) {
        $path = getcwd() . "/" . $path;
    }
    return $path;
}

function onProgress(int $i, int $total, string $name, bool $success, ?string $errorMessage): void
{
    if ($success) {
        echo "Rendered item " . ($i + 1) . "/" . $total . ": " . $name . PHP_EOL;
    } else {
        echo "Failed to render item " . ($i + 1) . "/" . $total . ": " . $name . ($errorMessage ? " (" . $errorMessage . ")" : "") . PHP_EOL;
    }
}

$output = resolveOption($options, "output", "o");
$assets = resolveArrayOption($options, "assets", "a");

if ($output === null || empty($assets)) {
    fwrite(STDERR, "Error: --assets and --output are required. Use --help for usage.\n");
    exit(1);
}

$output = resolvePath($output);
$assets = array_map(resolvePath(...), $assets);

$libraryGenerator = ItemLibraryGenerator::fromAssetsFolders($assets, $output);

$libraryGenerator->setNamespaces(resolveArrayOption($options, "namespace", "n", ["minecraft"]))
    ->setSize((int) resolveOption($options, "size", "s", 64))
    ->setQuality((int) resolveOption($options, "quality", "q", 2))
    ->setCreateItemList(isset($options["item-list"]) || isset($options["i"]))
    ->setPrefix(resolveOption($options, "prefix", "p", "rc-"))
    ->setFormat(resolveOption($options, "format", "f", "webp"))
    ->setCreatePngFallback(isset($options["fallback"]))
    ->render(onProgress(...));

echo "Saved stylesheet and textures to " . $output . "\n";
